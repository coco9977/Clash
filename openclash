# ==========================================================
# 开启 IPV6 + 高阶 Meta 规则 DNS 分流防泄露配置
# ==========================================================

[General]
CORE_TYPE = Meta

# --- 代理与模式 ---
# 插件运行模式 fake-ip/fake-ip-tun/fake-ip-mix
EN_MODE = fake-ip
# 启用 UDP 代理
ENABLE_UDP_PROXY = 1
# 禁用 UDP QUIC
DISABLE_UDP_QUIC = 1
# 路由器自身代理
ROUTER_SELF_PROXY = 1
# TUN 网络栈类型 system/gvisor/mixed
STACK_TYPE = mixed
# 代理模式 rule/global/direct
PROXY_MODE = rule

# --- IPv6 相关 (开启 IPv6) ---
# 启用 IPv6
IPV6_ENABLE = 1
# 启用 IPv6 DNS
IPV6_DNS = 1
# IPv6 代理模式
IPV6_MODE = 0
# 启用 IPv6 UDP 代理
ENABLE_V6_UDP_PROXY = 1

# --- 分流相关 ---

# --- DNS 相关 (防止 DNS 泄露的基础保障) ---
# DNS 重定向模式
ENABLE_REDIRECT_DNS = 1
# 自定义 DNS
ENABLE_CUSTOM_DNS = 1
# 自动追加 default-nameserver DNS
APPEND_DEFAULT_DNS = 0
# 追加上游分配 DNS
APPEND_WAN_DNS = 0
# DNS 查询是否遵循规则
ENABLE_RESPECT_RULES = 1
# 自定义 Nameserver-Policy
CUSTOM_NAME_POLICY = 1
# 自定义 Fallback-Filter
CUSTOM_FALLBACK_FILTER = 1

# --- Fake-IP 设置 (流量劫持防泄露) ---
# 启用 fake-ip 缓存
STORE_FAKEIP = 1
# 启用 Fake-IP-Filter
CUSTOM_FAKEIP_FILTER = 1
# Fake-IP 过滤模式
CUSTOM_FAKEIP_FILTER_MODE = blacklist
# 自定义 Fake-IP 地址段
FAKEIP_RANGE = 198.18.0.1/16

# --- 域名嗅探 (辅助防泄露和精准分流) ---
# 启用域名嗅探
ENABLE_META_SNIFFER = 1
# 启用自定义嗅探规则
ENABLE_META_SNIFFER_CUSTOM = 1
# 强制嗅探纯 IP 连接
ENABLE_META_SNIFFER_PURE_IP = 1

# --- 其它基础配置 ---
# 仅允许内网访问
INTRANET_ALLOWED = 1
# 启用 TCP 并发
ENABLE_TCP_CONCURRENT = 1
# 启用统一延迟
ENABLE_UNIFIED_DELAY = 1
# 模块更新后重启插件
RESTART = true

# ==========================================================
# 底层 YAML 覆写块 (零泄露终极形态)
# ==========================================================

[YAML]
# 1. 域名嗅探精细化配置
sniffer!:
  enable: true
  parse-pure-ip: true
  sniff:
    TLS:
      ports: [443, 8443]
    HTTP:
      ports: [80, 8080-8880]
      overwrite-destination: true
    QUIC:
      ports: [443]

# 2. 高级 DNS 逻辑配置 (重构版)
dns!:
  enable: true
  listen: 0.0.0.0:7874
  ipv6: true
  respect-rules: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter-mode: rule
  
  # Fake-IP 过滤名单 (移除了 cn real-ip 以提升国内网页打开速度)
  fake-ip-filter:
    - GEOSITE,private,real-ip
    - DOMAIN-SUFFIX,localhost,real-ip
    - DOMAIN-SUFFIX,local,real-ip
    - DOMAIN-SUFFIX,lan,real-ip
    - DOMAIN-SUFFIX,msftconnecttest.com,real-ip
    - DOMAIN-SUFFIX,msftncsi.com,real-ip
    - MATCH,fake-ip
    
  # 引导 DNS (仅用于建立连接时解析基础 DoH 域名)
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29

  # 精准分流：明确知道是国内的域名，才允许去请求阿里/腾讯 DNS
  nameserver-policy:
    "geosite:cn,private":
      - https://dns.alidns.com/dns-query
      - https://doh.pub/dns-query

  # 核心防漏点：把 nameserver(默认DNS) 全部替换为国外加密 DNS 并强制走节点！
  nameserver:
    - "https://dns.google/dns-query"
    - "https://cloudflare-dns.com/dns-query"
  
  # 代理节点与直连逻辑的基础 DNS 解析
  proxy-server-nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query

  direct-nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query

  direct-nameserver-follow-policy: true
