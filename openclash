# ==========================================================
# 【DNS 解析与防泄露覆写模块】
# 作用：接管全网域名解析。国内走阿里/腾讯直连，国外强制走节点加密解析。
# ==========================================================
dns!:
  enable: true                    
  listen: 0.0.0.0:7874            
  ipv6: true                      
  respect-rules: true             
  enhanced-mode: fake-ip          
  fake-ip-range: 198.18.0.1/16    
  
  # Fake-IP 白名单：确保局域网 NAS、Docker 容器以及国内域名获取真实 IP
  fake-ip-filter: 
    - "geosite:private"           
    - "geosite:cn"                
    - "+.localhost"               
    - "+.local"                   
    - "+.lan"                     
    - "+.msftconnecttest.com"     
    - "+.msftncsi.com"            
    
  default-nameserver: 
    - 223.5.5.5                   
    - 119.29.29.29                
    - 2400:3200::1                

  nameserver-policy: 
    "geosite:cn,private":
      - https://dns.alidns.com/dns-query
      - https://doh.pub/dns-query
    "geosite:geolocation-!cn":
      - "https://dns.google/dns-query#自建-故转"
      - "https://1.1.1.1/dns-query#自建-故转"

  nameserver: 
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query

  fallback: 
    - "https://dns.google/dns-query#自建-故转"
    - "https://1.1.1.1/dns-query#自建-故转"

  fallback-filter: 
    geoip: true                   
    geoip-code: CN                
    geosite:
      - gfw                       
    domain: 
      # 极高危防风控白名单：无视一切，强制节点解析，防封号
      - "+.openai.com"
      - "+.chatgpt.com"
      - "+.anthropic.com"
      - "+.claude.ai"
      - "+.google.com"
      - "+.googleapis.com"
      - "+.gstatic.com"
      - "+.googlevideo.com"
      - "+.youtube.com"
      - "+.facebook.com"
      - "+.telegram.org"

  proxy-server-nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
  direct-nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
  direct-nameserver-follow-policy: true

# ==========================================================
# 【流量嗅探覆写模块】
# 作用：从纯 IP 流量中提取真实域名，确保分流规则正常工作。
# ==========================================================
sniffer!: 
  enable: true                    
  force-dns-mapping: true         
  parse-pure-ip: true             
  override-destination: true      
  sniff:
    HTTP:
      ports: [80, 8080-8880]
      override-destination: true
    TLS:
      ports: [443, 8443]          
    QUIC:
      ports: [443, 8443]          
  
  skip-domain: 
    - "+.mi.com"                  
    - "+.xiaomi.com"
    - "+.apple.com"               
    - "+.push.apple.com"          
    - "+.msftconnecttest.com"     
    - "+.msftncsi.com"            
    - "+.googlevideo.com"
