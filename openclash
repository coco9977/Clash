# ==========================================================
# ==== 以下为 [General] 块：控制 OpenClash 插件底层行为 ====
# ==========================================================
[General]
CORE_TYPE = Meta

# --- DNS 相关 (让界面设置让步，交由下面的 YAML 块完全接管) ---
ENABLE_REDIRECT_DNS = 1
ENABLE_CUSTOM_DNS = 0
APPEND_DEFAULT_DNS = 0
APPEND_WAN_DNS = 0
STORE_FAKEIP = 1
ENABLE_RESPECT_RULES = 1

# --- IPv6 相关 (底层开启 IPv6) ---
IPV6_ENABLE = 1
IPV6_DNS = 1

# --- 代理与模式 ---
EN_MODE = fake-ip
DISABLE_UDP_QUIC = 1
PROXY_MODE = rule


# ==========================================================
# ==== 以下为 YAML 块：配置文件语法级别覆写 ====
# ==========================================================
# [YAML] 标记必不可少，插件遇到此标记才会开始识别 YAML 修改
# [YAML]

# 1. 基础网络设置 (默认合并替换当前键值)
ipv6: true
allow-lan: true
unified-delay: true
tcp-concurrent: true

# 2. Meta 专属嗅探器配置 (使用 ! 操作符，强制覆盖原有 sniffer 对象)
sniffer!:
  enable: true
  parse-pure-ip: true
  sniff:
    tls:
      ports: [443, 8443]
    http:
      ports: [80, 8080-8880]

# 3. 终极防泄露 DNS 配置 (使用 ! 操作符，强制清理并覆盖整个 DNS 对象，彻底杜绝插件自带的冗余 DNS 干扰)
dns!:
  enable: true
  ipv6: true
  listen: 0.0.0.0:7874
  
  # 开启 Fake-IP
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - '*.lan'
    - '*.localdomain'
    - '*.localhost'
    - '*.local'
    - '*.home.arpa'
    - 'time.*.com'
    - 'time.*.gov'
    - 'time.*.edu.cn'
    - 'time.*.apple.com'
    - 'ntp.*.com'
    - 'stun.*.*'
    - 'xbox.*.*.microsoft.com'
    - '*.msftncsi.com'
    - '*.msftconnecttest.com'

  # default-nameserver: 仅作解析下方的 DoH/DoT 的真实 IP 用
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
    - 2400:3200::1     # 阿里 IPv6
    - 2402:4e00::      # DNSPod IPv6

  # nameserver: 兜底使用，解析非国内域名
  nameserver:
    - https://dns.google/dns-query
    - https://cloudflare-dns.com/dns-query
    - tls://8.8.4.4

  # nameserver-policy: 基于 Meta GeoSite 前置精准分流
  nameserver-policy:
    'geosite:cn,private': # 国内与局域网域名，直通国内 DNS
      - https://dns.alidns.com/dns-query
      - https://doh.pub/dns-query
    'geosite:geolocation-!cn': # 国外域名，强制远端加密解析，防污染防泄露
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query
